		{"id":"s5e05","fromNode":"s5a2infl0001","fromSide":"bottom","toNode":"s5a2chamas0001","toSide":"top","color":"3","label":"3 ignições = ativa"},
		{"id":"s5e06","fromNode":"s5a2chamas0001","fromSide":"bottom","toNode":"s5a2camaras0001","toSide":"top","color":"6","label":"fogo = dilema"},
